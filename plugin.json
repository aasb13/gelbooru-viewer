{
    "id": "gelbooruDux",
    "name": "Gelbooru",
    "description": "Browse Gelbooru in its own window, from the dock, the launcher and the dash",
    "version": "0.1.0",
    "author": "desu",
    "type": "composite",
    "capabilities": [
        "daemon",
        "dankbar-widget",
        "control-center",
        "dash-tab",
        "dash-card"
    ],
    "icon": "image",
    "components": {
        "daemon": "./GelbooruDaemon.qml",
        "widget": "./GelbooruPill.qml",
        "launcher": "./GelbooruLauncher.qml",
        "dash": "./GelbooruDashTab.qml",
        "dashCard": "./GelbooruDashCard.qml"
    },
    "settings": "./GelbooruSettings.qml",
    "trigger": "",
    "dash": {
        "title": "Gelbooru",
        "card": {
            "title": "Gelbooru",
            "w": 2,
            "h": 1,
            "minW": 1,
            "minH": 1,
            "maxW": 4,
            "maxH": 2
        }
    },
    "requires_dms": ">=1.7.0",
    "permissions": [
        "settings_read",
        "settings_write",
        "network"
    ]
}
